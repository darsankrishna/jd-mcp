# Copy to .env and fill in. .env holds secrets: never commit it.

# Public DNS names, both pointing at this server.
AUTH_DOMAIN=auth.example.org
MCP_DOMAIN=papers.example.org

# Use long random values, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=

# Optional provider keys
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=
CORE_API_KEY=
